{
  "schema_version": 2,
  "server": {
    "host": "127.0.0.1",
    "port": 9982,
    "api_key": "ocswitch-local"
  },
  "providers": [
    {
      "id": "vendor-a",
      "name": "Vendor A",
      "base_url": "https://api.example.com/v1",
      "groups": [
        {
          "id": "default",
          "name": "Default",
          "protocol": "openai-responses",
          "api_key": "sk-primary",
          "models": ["model-a"]
        }
      ]
    }
  ],
  "aliases": [
    {
      "alias": "wildcard-chat",
      "protocol": "openai-responses",
      "enabled": true,
      "targets": [
        {
          "provider": "vendor-a",
          "group": "default",
          "model": "model-a",
          "enabled": true
        }
      ]
    }
  ],
  "request_rewrite_rules": [
    {
      "name": "empty-providers-wildcard",
      "alias": "wildcard-chat",
      "provider_groups": [],
      "enabled": true,
      "ops": [
        {
          "op": "set",
          "path": "$.store",
          "value": false
        }
      ]
    },
    {
      "name": "omitted-providers-wildcard",
      "alias": "wildcard-chat",
      "provider_groups": [],
      "enabled": true,
      "ops": [
        {
          "op": "delete",
          "path": "$.parallel_tool_calls"
        }
      ]
    }
  ],
  "auto_alias_enabled": true
}
