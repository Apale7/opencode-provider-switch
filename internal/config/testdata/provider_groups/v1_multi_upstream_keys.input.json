{
  "schema_version": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 9982,
    "api_key": "ocswitch-local"
  },
  "providers": [
    {
      "id": "vendor-keys",
      "name": "Vendor Multi Keys",
      "protocol": "openai-compatible",
      "base_url": "https://keys.example.com/v1",
      "api_key": "sk-primary",
      "api_keys": ["sk-backup-1", "sk-backup-2"],
      "models": ["model-a", "model-b"],
      "models_source": "discovered"
    }
  ],
  "aliases": [
    {
      "alias": "multi-key-chat",
      "protocol": "openai-compatible",
      "enabled": true,
      "targets": [
        {
          "provider": "vendor-keys",
          "model": "model-a",
          "enabled": true
        }
      ]
    }
  ],
  "auto_alias_enabled": true
}
