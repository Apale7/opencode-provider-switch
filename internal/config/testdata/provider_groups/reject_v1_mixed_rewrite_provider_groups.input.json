{
  "schema_version": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 9982,
    "api_key": "ocswitch-local"
  },
  "providers": [
    {
      "id": "vendor-a",
      "name": "Vendor A",
      "protocol": "openai-responses",
      "base_url": "https://api.example.com/v1",
      "api_key": "sk-primary",
      "models": ["model-a"]
    }
  ],
  "aliases": [
    {
      "alias": "model-a",
      "enabled": true,
      "targets": [
        {
          "provider": "vendor-a",
          "model": "model-a",
          "enabled": true
        }
      ]
    }
  ],
  "request_rewrite_rules": [
    {
      "name": "strip-store",
      "alias": "model-a",
      "provider_groups": [
        {
          "provider": "vendor-a",
          "group": "default"
        }
      ],
      "enabled": true,
      "ops": [
        {
          "op": "delete",
          "path": "/store"
        }
      ]
    }
  ],
  "auto_alias_enabled": true
}
