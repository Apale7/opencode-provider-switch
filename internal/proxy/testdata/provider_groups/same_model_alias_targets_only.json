{
  "schema_version": 2,
  "server": {
    "host": "127.0.0.1",
    "port": 0,
    "api_key": "ocswitch-local",
    "failover_status_codes": [401, 402, 403, 429]
  },
  "providers": [
    {
      "id": "vendor-a",
      "name": "Vendor A Same Model",
      "base_url": "https://vendor-a-same-model.example.test/v1",
      "base_url_strategy": "ordered",
      "disabled": false,
      "auto_alias_enabled": false,
      "groups": [
        {
          "id": "alpha",
          "name": "Alpha",
          "protocol": "openai-responses",
          "api_key": "sk-fake-alpha-1",
          "api_keys": ["sk-fake-alpha-2"],
          "models": ["shared-model", "alpha-only"],
          "models_source": "manual",
          "disabled": false
        },
        {
          "id": "beta",
          "name": "Beta",
          "protocol": "openai-responses",
          "api_key": "sk-fake-beta-1",
          "api_keys": ["sk-fake-beta-2"],
          "models": ["shared-model", "beta-only"],
          "models_source": "manual",
          "disabled": false
        },
        {
          "id": "gamma",
          "name": "Gamma Unlisted Sibling",
          "protocol": "openai-responses",
          "api_key": "sk-fake-gamma-1",
          "models": ["shared-model", "gamma-only"],
          "models_source": "manual",
          "disabled": false
        }
      ]
    }
  ],
  "aliases": [
    {
      "alias": "shared-only-targets",
      "display_name": "Same Model Alias Targets Only",
      "protocol": "openai-responses",
      "enabled": true,
      "targets": [
        {
          "provider": "vendor-a",
          "group": "beta",
          "model": "shared-model",
          "enabled": true
        },
        {
          "provider": "vendor-a",
          "group": "alpha",
          "model": "shared-model",
          "enabled": true
        }
      ]
    }
  ]
}
