        {
          "id": "openai-match",
          "name": "OpenAI Matching Sibling",
          "protocol": "openai-responses",
          "api_key": "sk-fake-openai-match",
          "models": ["model-fb"],
          "models_source": "manual",
          "disabled": false
        }
      ]
    }
  ],
  "aliases": [
    {
      "alias": "proto-mismatch",
